@using Churchee.Common.Abstractions.Auth
@using Churchee.Common.ValueTypes
@using Churchee.Module.UI.Components
@using Microsoft.AspNetCore.Components;
@using System.Text.Json

<ImageUpload Model="@Model" ModelChanged="HandleModelChange"/>

@code {

    protected override void OnInitialized()
    {

        if (string.IsNullOrEmpty(Value))
        {
            Model = new ImageUploadType() { Path = "/img/pages", ApplicationTenantId = TenantResolver.GetTenantId() };

            return;
        }

        var deconstructed = JsonSerializer.Deserialize<ImageSimple>(Value);

        if(deconstructed != null)
        {
            Model = new ImageUploadType { Description = deconstructed.AltText, ThumbnailUrl = $"{TenantResolver.GetCDNPrefix()}{deconstructed.Url}" + "_t.webp", SupportedFileTypes = ".jpg,.jpeg,.png,.gif" };
        }
    }

    public ImageUploadType Model { get; set; } = new();

    [Inject]
    protected ITenantResolver TenantResolver { get; set; } = default!;

    [Parameter] 
    public string Value { get; set; }

    [Parameter] 
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public Guid? PageId { get; set; }

    [Parameter] 
    public Func<ChunkedUploadRequest, Task<string>> OnUpload { get; set; }

    [Parameter] 
    public EventCallback<string> OnChanged { get; set; }

    private async Task HandleModelChange(ImageUploadType newValue)
    {

        if(newValue.File != null)
        {
            var data = new ImageSimple { AltText = newValue.Description, TempUrl = newValue.Value, Url = newValue.File.Name };

            Value = JsonSerializer.Serialize(data);
        }
        else
        {
            var data = new ImageSimple { AltText = newValue.Description, TempUrl = newValue.Value, Url = newValue.ThumbnailUrl };

            Value = JsonSerializer.Serialize(data);
        }

        await ValueChanged.InvokeAsync(Value);
    }
}
